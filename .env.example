# ---------------------------------------------------------------------------
# TriCV — copy this file to .env and adjust. `docker compose up` needs nothing
# else. Every variable the application reads is listed here.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Async driver (asyncpg) is required. Inside Compose the host is `db`.
DATABASE_URL=postgresql+asyncpg://tricv:tricv@db:5432/tricv

# Credentials the `db` service is created with. Keep in sync with DATABASE_URL.
POSTGRES_USER=tricv
POSTGRES_PASSWORD=tricv
POSTGRES_DB=tricv

# --- Auth ------------------------------------------------------------------
# CHANGE THIS IN PRODUCTION. Any random 64-char string will do:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Created by `make seed`. Never leave these defaults on a public deployment.
SEED_ADMIN_EMAIL=admin@tricv.example
SEED_ADMIN_PASSWORD=admin1234

# --- LLM provider ----------------------------------------------------------
# gemini | anthropic | ollama
LLM_PROVIDER=gemini

# Leave empty to use the provider's own default
# (gemini -> gemini-2.0-flash, anthropic -> claude-opus-5, ollama -> llama3.1).
LLM_MODEL=

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434

# Free tiers have low per-minute limits. This caps in-flight provider calls.
LLM_MAX_CONCURRENCY=3
LLM_TIMEOUT_SECONDS=120

# Log the exact payload sent to the provider (INFO level). Useful to verify
# redaction; noisy in production.
LLM_LOG_PAYLOAD=true

# --- Privacy ---------------------------------------------------------------
# true  -> extract text locally, redact identifiers, send text only (default)
# false -> send the original PDF/DOCX to the provider
PII_REDACTION=true

# Gender, age, date of birth, marital status, nationality. When true these are
# still extracted, stored and shown to HR — they are only removed from the
# payload used for scoring. See README "Why demographics are redacted".
REDACT_DEMOGRAPHICS=true

# --- Storage ---------------------------------------------------------------
# local | s3
STORAGE_BACKEND=local
STORAGE_PATH=/data/cv

# Only read when STORAGE_BACKEND=s3 (any S3-compatible endpoint).
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- HTTP ------------------------------------------------------------------
# Comma-separated. Must include the origin of any site embedding the widget.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000
MAX_UPLOAD_MB=10

# Public (unauthenticated) endpoints only.
PUBLIC_RATE_LIMIT_PER_HOUR=20

# Where the frontend reaches the API. Baked into the frontend at build time.
VITE_API_URL=http://localhost:8000
