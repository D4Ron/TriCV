# ---------------------------------------------------------------------------
# TriCV — copy this file to .env and adjust. `docker compose up` needs nothing
# else. Every variable the application reads is listed here.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Async driver (asyncpg) is required. Inside Compose the host is `db`.
DATABASE_URL=postgresql+asyncpg://tricv:tricv@db:5432/tricv

# Credentials the `db` service is created with. Keep in sync with DATABASE_URL.
POSTGRES_USER=tricv
POSTGRES_PASSWORD=tricv
POSTGRES_DB=tricv

# --- Auth ------------------------------------------------------------------
# CHANGE THIS IN PRODUCTION. Any random 64-char string will do:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Created by `make seed`. Never leave these defaults on a public deployment.
SEED_ADMIN_EMAIL=admin@tricv.example
SEED_ADMIN_PASSWORD=admin1234

# --- LLM provider ----------------------------------------------------------
# gemini | anthropic | ollama | openai
LLM_PROVIDER=gemini

# Leave empty to use the provider's own default
# (gemini -> gemini-2.0-flash, anthropic -> claude-opus-5, ollama -> llama3.1).
# LLM_PROVIDER=openai has no default: name the model explicitly.
LLM_MODEL=

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434

# `openai` covers every provider that speaks the OpenAI chat-completions
# dialect, which is most of them. Pick one, set the three variables below.
#
#   Mistral    LLM_BASE_URL=https://api.mistral.ai/v1
#              LLM_MODEL=ministral-14b-latest
#              Best French of the free tiers. On the free Experiment plan,
#              refuse training in Admin > Privacy.
#              NOT mistral-small/medium-latest: those are allocated ZERO
#              requests/minute on the free plan and return an immediate 429.
#              Only the `ministral` family is allocated — 3b (750/min),
#              8b (188/min), 14b (30/min). Measured equal to gemini-2.5-flash
#              on the extraction corpus; see tools/evaluer_extraction.py.
#   Groq       LLM_BASE_URL=https://api.groq.com/openai/v1
#              LLM_MODEL=llama-3.3-70b-versatile
#              Fastest, but 100K tokens/day free — about 14 dossiers.
#   OpenRouter LLM_BASE_URL=https://openrouter.ai/api/v1
#              LLM_MODEL=mistralai/mistral-small-3.2-24b-instruct:free
#   vLLM       LLM_BASE_URL=http://<machine>:8000/v1  (LLM_API_KEY=anything)
#
LLM_BASE_URL=
LLM_API_KEY=

# Fallback chain, tried in order when the primary runs out of allowance — and
# only then. A response that could not be read, or a rejected key, is a fault
# to see and fix, not a reason to change reader. Empty: no fallback.
#
#   LLM_FALLBACK=gemini
#
# A provider with no key is dropped from the chain instead of being fatal, so
# a switch can be configured before its key exists: the chain falls through to
# whatever works, and pasting the key promotes the new provider.
#
# Two cautions before enabling it. Two models do not read a CV the same way, so
# a mandate read by both produces a grid whose lines come from different
# readers — every switch is logged at WARNING, naming both. And free tiers do
# not share a privacy policy: Mistral's can be set to refuse training, Google's
# cannot. Falling back moves real career histories from one to the other.
LLM_FALLBACK=

# Who writes the prose — report sections and published avis — when that is not
# the provider that reads the dossiers. Extraction is one call per dossier and
# is what exhausts a quota; prose is ~7 calls per report but goes to the client
# under the firm's signature. Put the generous quota on the volume, and the
# provider that invents least on the prose. Empty: the same one does both.
LLM_PROSE_PROVIDER=

# Each provider's own model. Needed as soon as a chain exists: LLM_MODEL names
# the primary's model, and "mistral-small-latest" means nothing to Google.
GEMINI_MODEL=
ANTHROPIC_MODEL=
OLLAMA_MODEL=
OPENAI_MODEL=

# Free tiers have low per-minute limits. This caps in-flight provider calls.
LLM_MAX_CONCURRENCY=3
LLM_TIMEOUT_SECONDS=120

# Log the exact payload sent to the provider (INFO level). Useful to verify
# redaction; noisy in production.
LLM_LOG_PAYLOAD=true

# --- Privacy ---------------------------------------------------------------
# true  -> extract text locally, redact identifiers, send text only (default)
# false -> send the original PDF/DOCX to the provider
PII_REDACTION=true

# Gender, age, date of birth, marital status, nationality. When true these are
# still extracted, stored and shown to HR — they are only removed from the
# payload used for scoring. See README "Why demographics are redacted".
REDACT_DEMOGRAPHICS=true

# --- Storage ---------------------------------------------------------------
# local | s3
STORAGE_BACKEND=local
STORAGE_PATH=/data/cv

# Only read when STORAGE_BACKEND=s3 (any S3-compatible endpoint).
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- HTTP ------------------------------------------------------------------
# Comma-separated. Must include the origin of any site embedding the widget.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000
# Il n'y a plus de limite de taille reglable : un depot authentifie accepte le
# fichier tel quel, et le formulaire public a un plafond anti-abus fixe dans le
# code. Le stockage se maitrise en purgeant les mandats archives (Archives >
# Purger les fichiers).

# Public (unauthenticated) endpoints only.
PUBLIC_RATE_LIMIT_PER_HOUR=20

# Where the frontend reaches the API. Baked into the frontend at build time.
VITE_API_URL=http://localhost:8000

# --- HR self-registration --------------------------------------------------
# An HR account can read every candidate's CV and personal details, so this is
# off unless you turn it on. With a code set, visitors need the link AND the
# code. Self-registered accounts are always RECRUITER, never ADMIN.
ALLOW_SELF_REGISTRATION=false
SIGNUP_CODE=

# --- Boite de reception des candidatures ------------------------------------
# AMORCAGE SEULEMENT. Le reglage courant vit en base et se change depuis
# l'application : Parametres > Boite de candidatures. Ces valeurs ne servent
# qu'a preconfigurer une installation neuve ; les modifier apres le premier
# demarrage n'a plus d'effet.
#
# Gmail : IMAP_HOST=imap.gmail.com, et IMAP_PASSWORD doit etre un
# "mot de passe d'application" (Compte Google > Securite > Validation en deux
# etapes > Mots de passe des applications). Le mot de passe du compte est
# refuse par Gmail en IMAP.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# --- Envoi de courriels -----------------------------------------------------
# AMORCAGE SEULEMENT, comme la reception : le reglage courant vit en base et se
# change depuis Parametres > Envoi de courriels.
#
# Sert a ecrire aux candidats (convocation, piece manquante, reponse) et a
# transmettre au client son lien d'acces a l'espace de suivi. Sans cette
# configuration, ces envois sont refuses avec un message explicite plutot que
# perdus en silence.
#
# Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, et SMTP_PASSWORD doit etre
# un "mot de passe d'application", comme pour l'IMAP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
# Ce que les destinataires verront en "De :". A defaut, SMTP_USER est utilise.
SMTP_EXPEDITEUR=

# --- Adresse publique de l'application --------------------------------------
# L'adresse par laquelle candidats et clients atteignent l'application. Elle
# sert a construire les liens envoyes par courriel (activation d'un acces
# client, page d'un avis) : le serveur ne connait que son adresse d'ecoute et
# ne peut pas la deviner. Sans elle, l'ouverture d'un acces client affiche le
# lien a transmettre soi-meme.
URL_PUBLIQUE=
